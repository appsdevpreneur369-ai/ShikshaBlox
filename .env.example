# Copy to .env and change for anything beyond local development. Never commit .env.

# Hostnames: <school>.shikshablox.localhost, admin., api., media., mail.
SB_BASE_DOMAIN=shikshablox.localhost
SB_HTTP_PORT=80

# Host ports (5433 avoids clashing with a locally installed PostgreSQL)
SB_PG_PORT=5433
SB_REDIS_PORT=6380
SB_MINIO_PORT=9000
SB_MINIO_CONSOLE_PORT=9001
SB_SMTP_PORT=1025
SB_MAILPIT_UI_PORT=8025

# PostgreSQL
POSTGRES_SUPERUSER=sb_admin
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_OWNER_USER=sb_owner
DB_OWNER_PASSWORD=change-me
DB_APP_USER=sb_app
DB_APP_PASSWORD=change-me

# Object storage (MinIO locally, any S3-compatible store in production)
S3_ACCESS_KEY=sb_minio
S3_SECRET_KEY=change-me-at-least-8-chars
S3_PRIVATE_BUCKET=sb-private
S3_PUBLIC_BUCKET=sb-public

# Auth. Local values only; staging/prod refuse to start with "dev-only" secrets.
# Generate real ones with:  openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only-change-me
SB_DATA_KEY=dev-only-data-key-change-me

# Demo data: fictional schools (moriah, greenfield, sunrise, horizon) and *.test users.
SEED_ENABLED=true
SEED_PASSWORD=Shiksha@Dev2026
SEED_SUPERADMIN_EMAIL=superadmin@shikshablox.test
# Extra verified hosts per school, e.g. moriah=moriah.example.org
SEED_EXTRA_DOMAINS=

# Staging deployment (never committed): Supabase session-pooler connection string
STAGING_DB_URL=
